{
  "$id": "report-card",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Report Card",
  "description": "A metrics report with summary and action buttons.",
  "type": "object",
  "required": [
    "title",
    "metrics"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Report title."
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of report generation."
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "percent": {
            "type": "number"
          },
          "color": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "description": "Array of metric entries."
    },
    "summary": {
      "type": "string",
      "description": "Markdown summary text shown below metrics."
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "action"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "description": "Action buttons shown at the bottom."
    },
    "session_link": {
      "type": "object",
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "type": "string",
          "description": "Link text, e.g. \"View full session\"."
        },
        "url": {
          "type": "string",
          "description": "Destination for the link — an http(s) URL when the full session/task/run is directly web-viewable, or an opaque identifier/URI (e.g. a Torque task ID, a mux session ID) when no direct URL exists yet. Non-http(s) values render as plain text rather than a clickable link."
        }
      },
      "additionalProperties": false,
      "description": "Optional link back to the full session/task/run this report distills — lets a host render 'summary + link' instead of a raw transcript dump."
    }
  },
  "default_render_target": "bottom_chat_drawer",
  "additionalProperties": false
}
